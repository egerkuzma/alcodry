<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>            <string>alcodry</string>
    <key>CFBundleDisplayName</key>     <string>alcodry</string>
    <key>CFBundleIdentifier</key>      <string>dev.egerkuzma.alcodry</string>
    <key>CFBundleExecutable</key>      <string>alcodry</string>
    <key>CFBundleIconFile</key>        <string>AppIcon</string>
    <key>CFBundlePackageType</key>     <string>APPL</string>
    <key>CFBundleShortVersionString</key> <string>1.0</string>
    <key>CFBundleVersion</key>         <string>1</string>
    <key>LSMinimumSystemVersion</key>  <string>13.0</string>

    <!-- Живём в строке меню: ни иконки в Dock, ни окна при запуске. -->
    <key>LSUIElement</key>             <true/>

    <!-- Сервер отвечает по http в домашней сети, без TLS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key> <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Читает состояние трекера с домашнего сервера.</string>
</dict>
</plist>
